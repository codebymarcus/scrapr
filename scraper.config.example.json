{
  // Copy this file to scraper.config.json and edit. Settings here are defaults;
  // any CLI flag overrides them for a single run. Comments (// and /* */) are
  // allowed. Delete keys you don't need — omitted keys fall back to defaults.

  // --- Output ---
  "out": "comics",         // output folder. Single URL: exact dir. Batch (--list): parent dir, one subfolder per link.
  "format": "jpg",         // image format: "jpg" | "png" | "webp" | "keep" (original). "pdf": true forces "jpg".
  "quality": 88,           // JPEG/WebP quality, 1–100 (85–90 recommended).
  "maxEdge": 2400,         // cap the longest image side in px (aspect kept, never upscales).
  "cbz": false,            // also write a .cbz archive: true | false.
  "pdf": true,             // also write a .pdf (one page per image): true | false.
  "keepLoose": false,      // keep the loose image files too: true | false (false = only the archive(s)).
  "text": false,             // scrape pages as article text (HTML → Markdown, saved as a .md with YAML frontmatter) instead of images: true | false. Same as --text.
  "textMode": "article",     // what --text extracts: "article" (one .md) | "pattern" (regex records: email/phone/url/name=/re/) | "selector" (CSS records). pattern/selector write aggregate <out>.json + .csv. Same as --pattern / --select.
  "httpFirst": true,         // text modes: try a plain static HTTP fetch first and only escalate to the browser when needed. false = always use the browser (same as --no-http-first).

  // --- Google Drive upload (optional; needs credentials.json + token.json) ---
  "drive": true,                 // enable uploading the produced .cbz/.pdf: true | false.
  "driveFolder": "PUT_PARENT_FOLDER_ID_HERE", // parent folder id (from the Drive URL after /folders/); null = My Drive root.
  "driveSubfolder": "Comics",    // folder created on the fly inside driveFolder; null = upload directly into driveFolder.
  "driveOnly": "pdf",            // upload only this type: "pdf" | "cbz" | null (upload both that were produced).
  "driveCredentials": "credentials.json", // path to the OAuth client JSON.
  "driveToken": "token.json",             // path to the token from `node authorize.mjs`.

  // --- Disk space ---
  "cleanup": true,         // after a link uploads OK, delete its local files; also delete a partial (incomplete) download. Needs "drive" to delete on success.

  // --- Navigation / pacing (usually fine at defaults) ---
  "advanceKey": "ArrowRight",  // key that turns the page: "ArrowRight" | "ArrowDown" | "PageDown" | "Space" | ...
  "settle": 700,               // ms to wait after each page turn.
  "jitter": 0.3,               // randomize every wait by ± this fraction (0–1).
  "itemDelay": 3000,           // ms pause between links in batch mode.
  "maxDomainFailures": 3,       // circuit breaker: after N consecutive rate-limit/block/timeout failures on one host in a run, skip its remaining rows (left to retry) and grow the delay before then. 0 disables.
  "headed": false,             // show the browser window (for debugging): true | false.
  "dryRun": false,             // preview the batch (targets, skips, Drive dest) without scraping or uploading.
  "cache": true,               // resumable page cache: keep downloaded pages between runs so an interrupted link resumes instead of re-downloading. false = --no-cache.
  "acceptPartial": false,      // when a rerun finds no new pages, keep what's cached and mark done instead of retrying forever.
  "verbose": false,            // per-page capture, skip reasons, phase timings, config summary.
  "debug": false,              // low-level detail: every image response, key presses, navigation, rate-limit math, cache hits.
  "logFile": null,             // write a full timestamped trace of every level to this path (e.g. "run.log").
  "costPerGb": null            // estimate metered-proxy cost: report data volume, plus a ~$ estimate at this per-GB rate (e.g. 4).

  // --- Scraping strategies (OVERRIDE; optional) ---
  // By default the pipeline is chosen per-site by a profile (batcave → hash
  // addressing; everything else → keyboard advance). Set this to force a
  // specific pipeline for ALL links instead. Off by default (commented out) so
  // the per-site profile is used; uncomment to override.
  // "strategies": [
  //   { "name": "current",       "enabled": true, "maxAttempts": 2 },
  //   { "name": "chapter-aware", "enabled": true, "maxAttempts": 1 }
  // ]

  // Other overridable keys (see README): countSelector, forcePages, maxRetries,
  // rateLimitBase, navTimeout, minBytes, hostFilter, issuePrefix, allImages,
  // cbzName, pdfName.
}

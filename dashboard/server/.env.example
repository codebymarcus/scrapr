# dashboard/server/.env.example
# Copy to `dashboard/server/.env` and fill in. The server loads it automatically
# (dotenv). The real .env is gitignored — never commit it.
# In Docker compose these can instead be set under the server service's
# `environment:` (compose already wires `env_file: ./dashboard/server/.env`).

# --- Google Drive OAuth (the dashboard's "Connect Google Drive" button) ---
# Create an OAuth 2.0 client of type "Web application" in Google Cloud Console
# -> APIs & Services -> Credentials. Enable the Google Drive API.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-web-client-secret

# Must EXACTLY equal the origin you browse the dashboard from + /api/drive/callback,
# AND be registered under the OAuth client's "Authorized redirect URIs".
#   compose (nginx, :8080):    http://localhost:8080/api/drive/callback
#   compose dev (Vite, :5173): http://localhost:5173/api/drive/callback
#   local `npm start` (:5174): http://localhost:5174/api/drive/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/drive/callback

# Base64-encoded 32-byte key that encrypts the stored Drive token at rest.
# Generate ONCE and keep it stable - changing it makes the saved token undecryptable
# (you would just click "Connect" again). Without it, Drive stays "not configured".
#   openssl rand -base64 32
#   (or) node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_SECRET_KEY=

# --- Server bind (optional; usually set by compose) ---
# HOST=127.0.0.1
# PORT=5174

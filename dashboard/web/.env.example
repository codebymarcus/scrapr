# dashboard/web/.env.example
# Copy to `dashboard/web/.env` and fill in. Only needed for LOCAL (non-Docker)
# `vite` dev — Docker compose sets these for you. The real .env is gitignored.

# Where the SPA calls the API and WebSocket. With Vite's dev proxy (below),
# leave these as the Vite origin; the proxy forwards /api (incl. /api/ws) to the server.
VITE_API_BASE=http://localhost:5173
VITE_WS_BASE=ws://localhost:5173

# The dev server proxies /api to the backend. Point this at the server's origin.
VITE_PROXY_TARGET=http://localhost:5174
